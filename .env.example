# ── เว็บ ─────────────────────────────────────────────────────────────────
# production = https://worktrain.workstationoffice.com (ใช้ทำลิงก์ในข้อความ LINE)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── ฐานข้อมูล ─────────────────────────────────────────────────────────────
# บนเครื่อง dev ใช้ PGlite ไม่ต้องมี Neon: DATABASE_URL=pglite:.pglite แล้วรัน `npm run db:dev-setup` ครั้งแรก
# Production = Neon โปรเจกต์ WorkTrain (ยังไม่ได้สร้าง) · ห้ามต่อฐานของระบบอื่น (กติกาเครือข้อ 2)
DATABASE_URL=pglite:.pglite

# ── session ───────────────────────────────────────────────────────────────
# สุ่มเอง: openssl rand -base64 48 · Production กับ Preview ใช้คนละค่า
SESSION_SECRET=

# ── WorkID (SSO + /v1/org) ────────────────────────────────────────────────
WORKID_BASE_URL=https://workid.workstationoffice.com
WORKID_APP_KEY=worktrain         # ต้องตรงกับ app key ที่ลงทะเบียนไว้ที่ WorkID (เปลี่ยนทีหลังไม่ได้) · role: admin · author · user
WORKID_API_KEY=                  # consumer key ชื่อ worktrain · scope read · ออกที่ WorkID /admin/consumers

# ── GateWay (ส่ง LINE ผ่าน Work Bot · spec §11) ──────────────────────────────
GATEWAY_BASE_URL=https://gateway.workstationoffice.com
GATEWAY_API_KEY=                 # ตั้งเฉพาะ Production — preview จึงส่ง LINE ไม่ได้
GATEWAY_LINE_CHANNEL_ID=2009617838   # OA Work Bot
# ช่วง dev ทุกข้อความ (รวมตัวต่อตัว) ไปกลุ่ม Test — ลบออกจาก Production เมื่อเปิดใช้จริง
TEST_LINE_GROUP_ID=

# ── cron รอบเช้า (มอบ + เตือน · vercel.json 09:00 เวลาไทย) ───────────────────
# Vercel แนบ `Authorization: Bearer <CRON_SECRET>` ให้ cron เอง · ไม่ได้ตั้ง = /api/cron/* ตอบ 401 ทุกครั้ง
CRON_SECRET=

# ── AI ออกข้อสอบ (Claude Opus 5.5 · spec §3) ──────────────────────────────
# ไม่ตั้ง = ปุ่ม "ให้ AI ออกข้อสอบ" บอกว่ายังไม่ได้ตั้ง · เอกสารที่ส่งไปเป็นข้อมูลลับทางการค้า — ตั้งเป็น Sensitive เฉพาะ Production
ANTHROPIC_API_KEY=

# ── ที่เก็บเอกสารต้นทาง (Cloudflare R2 แบบ private · ADR-0010) ────────────────
# bucket ต้องมี CORS ให้ PUT จากโดเมนของ WorkTrain · ไม่ตั้ง = บนเครื่อง dev ใช้ที่เก็บในหน่วยความจำแทน · บน Vercel อัปไม่ได้
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── สแกนใบหน้า (AWS Rekognition Face Liveness + CompareFaces · ADR-0006) ──────
# ไม่ตั้งครบ = บน production เริ่มเรียน/สอบไม่ได้ (ตั้งใจปิด) · บนเครื่อง dev มีปุ่มข้ามกล้อง
# region ต้องมี Face Liveness — ตรวจก่อนเปิดใช้ แล้วเขียนไว้ในข้อความยินยอม (กติกาเครือข้อ 7)
AWS_REKOGNITION_REGION=
# IAM user ของเซิร์ฟเวอร์: rekognition:CreateFaceLivenessSession · GetFaceLivenessSessionResults · CompareFaces · sts:AssumeRole
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# role ที่เบราว์เซอร์ใช้ผ่าน credential ชั่วคราว 15 นาที — ให้แค่ rekognition:StartFaceLivenessSession
AWS_LIVENESS_ROLE_ARN=

# ── API ให้ระบบอื่นในเครือ (`/api/v1/*` · spec §6) ───────────────────────────
# `ชื่อ:read:<sha256 ของ key>` คั่นจุลภาค · ออก key ด้วย `npm run api:new-key -- workhr` · ไม่ตั้ง = /api/v1/* ตอบ 401 ทุกครั้ง
WORKTRAIN_API_CONSUMERS=

# ── ทางลัดบนเครื่อง dev เท่านั้น (ตายบน Vercel ทุก environment) ───────────
# WORKTRAIN_DEV_ACTOR="personId:อีเมล:ชื่อ:admin|author|user"
# WORKTRAIN_DEV_ORG='[{"personId":1,"email":"a@b.c","fullName":"ชื่อ สกุล","positionId":41,"teamId":3,"managerPersonId":2}]'
